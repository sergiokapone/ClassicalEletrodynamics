\begin{tikzpicture}[>=latex, thick, scale=2]

  % джерело
  \node[text=red] (src) at (-0.5,0) {\faIcon{rocket}};
  \node[below left=4pt] at (src) {$x_s(\tau_s)$};

  % хвильові фронти (дужки)
  \foreach \r/\op in {0.5/1.0, 0.9/0.7, 1.3/0.45} {
    \draw[red, opacity=\op, line width=0.8pt]
      (\r+0.3, 0) arc (0:60:\r+0.3)
      (\r+0.3, 0) arc (0:-60:\r+0.3);
  }

  % вектор v 
  \draw[->] (src) -- ++(45:1)
    node[above] {$\vect{v}$};


  % вектор k (вправо)
  \draw[->] (src) -- ++(1, 0)
    node[midway, below] {$\vect{k}$};

  % спостерігач
  \node[font=\Large] (obs) at (4.2, 0) {\faIcon{male}};
  \node[below=15pt] at (obs) {$x_{\text{obs}}(\tau_{\text{obs}})$};

  % вектор n
  \draw[->] (obs) -- ++(-1,0)
    node[midway, above] {$\vect{n}$};

\end{tikzpicture}