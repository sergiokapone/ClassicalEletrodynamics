# PDF of the book: the build leaves it in the root, publish_pdf.ps1 moves it (linearized) to docs/, which is tracked
/ClassicalElectrodynamics.pdf
ClassicalElectrodynamics_*.pdf

# === HTML build (lwarp) ===
# its results lie in the root only until publish_html.py moves them to docs/ (anchored with /: docs/ is tracked)
/_html/
/lateximages/
/ClassicalElectrodynamics-html-images/
/ch*.html
/app*.html
/ClassicalElectrodynamics-html.html
/sitemap.xml
/pagefind/
lwarp*
*.lwarpmkconf
*.cut
*.sidetoc
*_html.tex
*-images.txt
ClassicalElectrodynamics-html_html.*
ClassicalElectrodynamics-html.pdf
sample_project.css
node_modules/

# local web server for the HTML book (python docs/serve.py): kept in docs/ by publish_html.py, not published
/docs/serve.py

# history of the ced.py shell
/.ced_history

